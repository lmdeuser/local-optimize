#!/bin/sh
set -e

case "${1:-}" in
    install|upgrade)
        if [ ! -x /usr/local/bin/ollama ] && [ ! -x /usr/bin/ollama ]; then
            echo 'local-optimize requires an installed Ollama binary and service.' >&2
            exit 1
        fi
        if ! getent passwd ollama >/dev/null 2>&1; then
            echo 'local-optimize requires the ollama system user.' >&2
            exit 1
        fi
        ;;
esac

#DEBHELPER#
exit 0
