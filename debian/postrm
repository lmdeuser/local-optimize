#!/bin/sh
set -e

case "${1:-}" in
    remove|purge)
        if [ -z "${DPKG_ROOT:-}" ] && command -v runuser >/dev/null 2>&1; then
            for runtime_dir in /run/user/*; do
                [ -d "$runtime_dir/systemd" ] && [ ! -L "$runtime_dir" ] || continue
                uid=${runtime_dir#/run/user/}
                case "$uid" in
                    ''|*[!0-9]*) continue ;;
                esac
                [ "$uid" -ge 1000 ] || continue
                [ "$(stat -c '%u' "$runtime_dir" 2>/dev/null || printf '%s' '-1')" = "$uid" ] || continue
                user_row=$(getent passwd "$uid" 2>/dev/null || true)
                user_name=${user_row%%:*}
                user_home=$(printf '%s\n' "$user_row" | cut -d: -f6)
                [ -n "$user_name" ] && [ -n "$user_home" ] || continue
                if [ -S "$runtime_dir/bus" ]; then
                    runuser -u "$user_name" -- env HOME="$user_home" USER="$user_name" LOGNAME="$user_name" XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus" systemctl --user daemon-reload >/dev/null 2>&1 || true
                else
                    runuser -u "$user_name" -- env HOME="$user_home" USER="$user_name" LOGNAME="$user_name" XDG_RUNTIME_DIR="$runtime_dir" systemctl --user daemon-reload >/dev/null 2>&1 || true
                fi
            done
        fi
        if [ "${1:-}" = "purge" ]; then
            rm -rf \
                /var/lib/local-optimize/venv \
                /var/lib/local-optimize/models \
                /var/cache/local-optimize
            rmdir /var/lib/local-optimize 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
