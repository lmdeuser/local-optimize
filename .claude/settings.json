{
  "permissions": {
    "deny": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(glab:*)",
      "Bash(tig:*)",
      "Bash(lazygit:*)",
      "Read(./.git/**)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Read(.git/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Glob(./.git/**)",
      "Glob(.git/**)",
      "Grep(./.git/**)",
      "Grep(.git/**)",
      "mcp__git__*",
      "mcp__github__*",
      "mcp__gitlab__*"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/hooks/deny_git.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
