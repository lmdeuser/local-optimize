# Copy to ~/.config/local-optimize/secrets.env, replace every placeholder,
# then set permissions to 0600. Never commit the resulting file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aiagent
DB_USER=aiagent
DB_PASSWORD=replace-with-the-local-database-password
DB_SSLMODE=prefer
RAG_BEARER_TOKEN=replace-with-a-long-random-local-token
